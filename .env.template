# Copy to .env (git-ignored) and fill in. Used by scripts/runpod/launch.sh.

# RunPod API key (Proton Pass: vault Operations, item "Runpod", field "API Key").
# Copied to the pod only so its watchdog can delete the pod at the cost cap.
RUNPOD_API_KEY=your-runpod-api-key

# Hugging Face token of an account with access to meta-llama/Llama-3.1-8B-Instruct
# (gated). vLLM on the pod downloads the official weights with it.
HF_TOKEN=your-hugging-face-token
